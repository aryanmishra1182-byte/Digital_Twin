# Environment Configuration for Explainable Digital Twin

# Backend (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:h2:mem:motortwindb;DB_CLOSE_DELAY=-1
DATABASE_USER=sa
DATABASE_PASSWORD=

# ML Service (Python FastAPI)
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001
ML_MODELS_DIR=ml/artifacts

# MQTT Configuration
MQTT_ENABLED=false
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=motor-twin-backend

# Frontend
VITE_API_URL=http://localhost:8080
